<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="botGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#6366f1" />
      <stop offset="100%" stop-color="#a855f7" />
    </linearGradient>
    <linearGradient id="faceGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  
  <!-- Outer Rounded Shield / Head -->
  <rect x="8" y="14" width="48" height="42" rx="14" fill="url(#botGrad)" />
  
  <!-- Headset band -->
  <path d="M 6 28 C 6 12, 58 12, 58 28" fill="none" stroke="#38bdf8" stroke-width="4" stroke-linecap="round" />
  <!-- Ear cups -->
  <rect x="3" y="24" width="6" height="14" rx="3" fill="#38bdf8" />
  <rect x="55" y="24" width="6" height="14" rx="3" fill="#38bdf8" />
  
  <!-- Antenna & Beacon -->
  <circle cx="32" cy="7" r="4" fill="#38bdf8" filter="url(#glow)" />
  <line x1="32" y1="11" x2="32" y2="14" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />

  <!-- Inner Screen / Faceplate -->
  <rect x="13" y="19" width="38" height="32" rx="10" fill="url(#faceGrad)" stroke="#334155" stroke-width="1.5" />
  
  <!-- Eyes (Glowing Cyan) -->
  <circle cx="24" cy="31" r="5" fill="#38bdf8" filter="url(#glow)" />
  <circle cx="40" cy="31" r="5" fill="#38bdf8" filter="url(#glow)" />
  <circle cx="26" cy="30" r="1.5" fill="#ffffff" />
  <circle cx="42" cy="30" r="1.5" fill="#ffffff" />
  
  <!-- Smile / Pulse Waveform -->
  <path d="M 23 42 Q 32 48 41 42" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
  
  <!-- Mic boom -->
  <path d="M 58 35 Q 52 50 42 51" fill="none" stroke="#94a3b8" stroke-width="2.5" stroke-linecap="round" />
  <circle cx="41" cy="51" r="2.5" fill="#38bdf8" />
</svg>
